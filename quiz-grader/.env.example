# Copy this file to .env and fill in your values. Never commit .env or paste your token into chat.

# Your school's HTTPS Canvas origin, no path (e.g. https://canvas.yourschool.edu)
CANVAS_BASE_URL=

# An instructor API token with permission to view and grade the target course
CANVAS_TOKEN=

# Optional. Set to 1 to force Safe Mode for this server regardless of session state,
# blocking all publishing (preview and confirm) even for demos. Leave unset otherwise.
CANVAS_SAFE_MODE=
